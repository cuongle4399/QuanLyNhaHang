<UserControl x:Class="restaurantManager.View.Fuction.Admin.revenueManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#2E2E2E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Height="50">
            <TextBlock Text="Quản lý doanh thu" Foreground="White"
                       FontSize="28" FontWeight="Bold" Margin="10,5"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0">
                <Border Width="180" Height="80" Background="#3B5998" Margin="5" CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Doanh thu" Foreground="White"/>
                        <TextBlock x:Name="txtTotalRevenue" Foreground="LightGreen" FontSize="16"/>
                    </StackPanel>
                </Border>
                <Border Width="180" Height="80" Background="#E67E22" Margin="5" CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Khách hàng" Foreground="White"/>
                        <TextBlock x:Name="txtInvoiceCount" Foreground="Yellow" FontSize="16"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                <Button Content="Tìm tất cả" Click="btnAll_Click" Width="110" Margin="5"/>
                <TextBlock Text="Từ:" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpFrom" Width="130" Margin="5"/>
                <TextBlock Text="Đến:" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpTo" Width="130" Margin="5"/>
                <Button Content="Tìm theo ngày" Click="btnSearch_Click" Width="140" Margin="5"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Column="0" x:Name="dgInvoices"
                          ItemsSource="{Binding Invoices}" 
                          AutoGenerateColumns="False"
                          MouseDoubleClick="dgInvoices_MouseDoubleClick"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeColumns="False"
                          CanUserResizeRows="False"
                          AlternatingRowBackground="#646464"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="dgInvoices_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã ĐH" Binding="{Binding MaDonHang}" Width="80"/>
                        <DataGridTextColumn Header="Ngày đặt" Binding="{Binding NgayDat, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/>
                        <DataGridTextColumn Header="Bàn" Binding="{Binding MaBan}" Width="80"/>
                        <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Column="2" Background="#3B3B3B" CornerRadius="5" Padding="5">
                    <DockPanel>
                        <TextBlock Text="Top Món Bán Chạy" DockPanel.Dock="Top" 
                                   Foreground="Gold" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>

                        <DataGrid ItemsSource="{Binding TopDishes}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="Transparent"
                                  RowBackground="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên món" Binding="{Binding TenMonAn}" Width="150" Foreground="White"/>
                                <DataGridTextColumn Header="SL" Binding="{Binding SoLuongBan}" Width="60" Foreground="White"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
