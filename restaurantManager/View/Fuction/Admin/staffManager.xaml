<UserControl x:Class="restaurantManager.View.Fuction.Admin.staffManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             FontFamily="Segoe UI"
             Background="#FAFAFA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Border Grid.Row="0" Background="White" Padding="20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <TextBlock Text="👥 QUẢN LÝ NHÂN VIÊN"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1976D2"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="1" Margin="20,20,20,15" CornerRadius="8" 
                BorderBrush="#E0E0E0" BorderThickness="1" Background="White">
            <DataGrid x:Name="DgNhanVien"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      AlternatingRowBackground="#FAFAFA"
                      RowBackground="White"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="Transparent" BorderThickness="0"
                      IsReadOnly="True"
                      ItemsSource="{Binding DgNhanVien}"
                      SelectionChanged="DgNhanVien_SelectionChanged"
                      Foreground="#212121"
                      RowHeight="38">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1976D2"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*"/>
                    <DataGridTextColumn Header="Ngày sinh" Binding="{Binding NgaySinh}" Width="*"/>
                    <DataGridTextColumn Header="SĐT" Binding="{Binding SoDienThoai}" Width="*"/>
                    <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="*"/>
                    <DataGridTextColumn Header="Lương" Binding="{Binding Luong}" Width="*"/>
                    <DataGridTextColumn Header="Chức vụ" Binding="{Binding ChucVu}" Width="*"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Form nhập liệu -->
        <Border Grid.Row="2" Background="White" Padding="20" 
                BorderBrush="#E0E0E0" BorderThickness="1,1,1,0">
            <StackPanel>
                <TextBlock Text="Thông tin nhân viên" FontSize="14" FontWeight="Bold" 
                           Foreground="#1976D2" Margin="0,0,0,15"/>

                <!-- Lưới 2 cột -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột 1 -->
                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Mã nhân viên" FontSize="12" 
                                   Foreground="#424242" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtMaNhanVien" Height="36" Padding="10" 
                                 Background="#F5F5F5" Foreground="#212121" BorderBrush="#BDBDBD" 
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Họ tên" FontSize="12" 
                                   Foreground="#424242" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtHoTen" Height="36" Padding="10" 
                                 Background="#F5F5F5" Foreground="#212121" BorderBrush="#BDBDBD" 
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Ngày sinh" FontSize="12" 
                                   Foreground="#424242" Margin="0,0,0,4"/>
                        <DatePicker x:Name="dpNgaySinh" Height="36" Padding="10" 
                                    Background="#F5F5F5" Foreground="#212121" BorderBrush="#BDBDBD" 
                                    Margin="0,0,0,12"/>

                        <TextBlock Text="SĐT" FontSize="12" 
                                   Foreground="#424242" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtSoDienThoai" Height="36" Padding="10" 
                                 Background="#F5F5F5" Foreground="#212121" BorderBrush="#BDBDBD" 
                                 Margin="0,0,0,0"/>
                    </StackPanel>

                    <!-- Cột 2 -->
                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                        <TextBlock Text="Địa chỉ" FontSize="12" 
                                   Foreground="#424242" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtDiaChi" Height="36" Padding="10" 
                                 Background="#F5F5F5" Foreground="#212121" BorderBrush="#BDBDBD" 
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Lương" FontSize="12" 
                                   Foreground="#424242" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtLuong" Height="36" Padding="10" 
                                 Background="#F5F5F5" Foreground="#212121" BorderBrush="#BDBDBD" 
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Chức vụ" FontSize="12" 
                                   Foreground="#424242" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtChucVu" Height="36" Padding="10" 
                                 Background="#F5F5F5" Foreground="#212121" BorderBrush="#BDBDBD" 
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Trạng thái" FontSize="12" 
                                   Foreground="#424242" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbTrangThai" Height="36" Padding="10" 
                                  Background="#F5F5F5" Foreground="#212121" BorderBrush="#BDBDBD">
                            <ComboBoxItem Content="Đang làm"/>
                            <ComboBoxItem Content="Nghỉ việc"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Nút chức năng -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="✅ Thêm" Width="100" Margin="0,0,10,0" 
                            Background="#4CAF50" Foreground="White" Click="Them_Click"
                            FontWeight="Bold" Padding="10,8" Cursor="Hand" />
                    <Button Content="✏️ Sửa" Width="100" Margin="0,0,10,0" 
                            Background="#FF9800" Foreground="White" Click="Sua_Click_1"
                            FontWeight="Bold" Padding="10,8" Cursor="Hand" />
                    <Button Content="🗑️ Đuổi" Width="100" 
                            Background="#F44336" Foreground="White" Click="Xoa_Click_2"
                            FontWeight="Bold" Padding="10,8" Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>