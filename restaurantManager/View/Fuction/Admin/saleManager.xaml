<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="restaurantManager.View.Fuction.Admin.saleManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FAFAFA"
             FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="25,20" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <TextBlock Text="📋 QUẢN LÝ KHUYẾN MÃI" 
                       FontSize="26" FontWeight="Bold" Foreground="#1976D2"/>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="25,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ Thêm" Command="{Binding AddCommand}"
                            Background="#4CAF50" Foreground="White" Padding="12,8" Margin="0,0,8,0"
                            FontSize="12" FontWeight="Bold" Cursor="Hand" 
                            BorderThickness="0" Height="36"/>

                    <Button Content="✏️ Sửa" Command="{Binding EditCommand}"
                            CommandParameter="{Binding SelectedPromotion}"
                            Background="#FF9800" Foreground="White" Padding="12,8" Margin="0,0,8,0"
                            FontSize="12" FontWeight="Bold" Cursor="Hand"
                            BorderThickness="0" Height="36"/>

                    <Button Content="🗑️ Xóa" Command="{Binding DeleteCommand}"
                            CommandParameter="{Binding SelectedPromotion}"
                            Background="#F44336" Foreground="White" Padding="12,8"
                            FontSize="12" FontWeight="Bold" Cursor="Hand"
                            BorderThickness="0" Height="36"/>
                </StackPanel>

                <!-- Search Box -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="200" Height="36" Padding="10,8" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderBrush="#E0E0E0" BorderThickness="1" 
                             Background="#F5F5F5" Foreground="#212121"
                             FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Margin="25" Background="White" 
                BorderBrush="#E0E0E0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Promotions}"
                      SelectedItem="{Binding SelectedPromotion}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" RowHeight="42"
                      AlternatingRowBackground="#FAFAFA"
                      Foreground="#212121"
                      Background="White"
                      RowHeaderWidth="0"
                      IsReadOnly="True"
                      CanUserResizeColumns="False"
                      CanUserSortColumns="True">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1976D2"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="BorderBrush" Value="#1565C0"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Foreground" Value="#212121"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Code" 
                                        Binding="{Binding MaCode}" 
                                        Width="100"/>

                    <DataGridTextColumn Header="Tên Chương Trình" 
                                        Binding="{Binding TenChuongTrinh}" 
                                        Width="*"
                                        MinWidth="200"/>

                    <DataGridTextColumn Header="Loại" 
                                        Binding="{Binding LoaiGiamGia}" 
                                        Width="110"/>

                    <DataGridTextColumn Header="Giá Trị" 
                                        Binding="{Binding GiaTriGiam, StringFormat=N0}" 
                                        Width="120"/>

                    <DataGridTextColumn Header="Từ Ngày" 
                                        Binding="{Binding NgayBatDau, StringFormat=dd/MM/yyyy}" 
                                        Width="110"/>

                    <DataGridTextColumn Header="Đến Ngày" 
                                        Binding="{Binding NgayKetThuc, StringFormat=dd/MM/yyyy}" 
                                        Width="110"/>

                    <DataGridTextColumn Header="Lượt Dùng" 
                                        Binding="{Binding SoLuotDaSuDung}" 
                                        Width="90"/>

                    <DataGridTextColumn Header="Trạng Thái" 
                                        Binding="{Binding TrangThai}" 
                                        Width="110"/>
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#FAFAFA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="Foreground" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>