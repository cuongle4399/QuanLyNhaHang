<UserControl x:Class="restaurantManager.View.Fuction.Admin.menuManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:restaurantManager.View.Fuction.Admin"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#1976D2"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1" 
                                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" TextBlock.Foreground="{TemplateBinding Foreground}" 
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,0,1,0"/>
                                <Setter Property="Foreground" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8F8F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <TextBlock Text="QUẢN LÝ THỰC ĐƠN" 
                       TextAlignment="Center"
                       FontSize="24"
                       FontWeight="Bold" 
                       Foreground="#1976D2"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="12,12,6,12">
                <StackPanel>
                    <!-- Food Info -->
                    <Border Background="White" CornerRadius="6" Padding="12" 
                            BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Thông tin" FontSize="13" FontWeight="Bold" 
                                       Foreground="#1976D2" Margin="0,0,0,10"/>
                            <TextBlock Text="Tên:" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="txtTenMon" Padding="8,6" Height="30" Margin="0,0,0,8"/>

                            <TextBlock Text="Mô tả:" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="txtMoTa" Padding="8,6" MinHeight="45" MaxHeight="70" 
                                     TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>

                            <TextBlock Text="Giá (đ):" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="txtGia" Padding="8,6" Height="30"/>
                        </StackPanel>
                    </Border>

                    <!-- Image -->
                    <Border Background="White" CornerRadius="6" Padding="12" 
                            BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Ảnh" FontSize="13" FontWeight="Bold" 
                                       Foreground="#1976D2" Margin="0,0,0,8"/>
                            <Button Click="Button_Click" Content="📁 Chọn ảnh" 
                                    Background="#2196F3" Foreground="White" 
                                    Padding="8,6" Height="30" Cursor="Hand" FontSize="11" Margin="0,0,0,8"/>
                            <Image x:Name="ImageFoodDiaLog" Height="75" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Category -->
                    <Border Background="White" CornerRadius="6" Padding="12" 
                            BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Loại:" FontSize="13" FontWeight="Bold" 
                                       Foreground="#1976D2" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cbbLoaiMonAn" Height="30"
                                      ItemsSource="{Binding DanhSachLoaiMonAn}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" FontSize="11"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="btnThem" Content="✅ Thêm" 
                                Background="#4CAF50" Foreground="White" 
                                Click="btnThem_Click" FontSize="11" Height="30" Cursor="Hand" 
                                Padding="6,4" Margin="0,0,6,0"/>
                        <Button x:Name="btnSua" Content="✏️ Sửa" 
                                Background="#FF9800" Foreground="White" 
                                Click="btnSua_Click" FontSize="11" Height="30" Cursor="Hand" 
                                Padding="6,4" Margin="0,0,6,0"/>
                        <Button x:Name="btnXoa" Content="🗑️ Xóa" 
                                Background="#F44336" Foreground="White" 
                                Click="btnXoa_Click" FontSize="11" Height="30" Cursor="Hand" 
                                Padding="6,4"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Panel -->
            <Grid Grid.Column="1" Margin="6,12,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tabs -->
                <TabControl x:Name="tabControl" Grid.Row="0" HorizontalAlignment="Stretch" Height="38"
                            BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <TabItem x:Name="All" Header="📋 Tất cả" PreviewMouseLeftButtonUp="TabItem_PreviewMouseLeftButtonUp" FontSize="12"/>
                    <TabItem x:Name="dish" Header="🍽️ Món ăn" PreviewMouseLeftButtonUp="TabItem_PreviewMouseLeftButtonUp" FontSize="12"/>
                    <TabItem x:Name="beverage" Header="🥤 Nước uống" PreviewMouseLeftButtonUp="TabItem_PreviewMouseLeftButtonUp" FontSize="12"/>
                </TabControl>

                <!-- List -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding DanhSachMonAn}" 
                          x:Name="lvMonAn"
                          SelectedItem="{Binding SelectedMonAn, Mode=TwoWay}" 
                          Background="White"
                          SelectionChanged="lvMonAn_SelectionChanged"
                          BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" BorderBrush="#F0F0F0" 
                                    Padding="10" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border CornerRadius="4" ClipToBounds="True">
                                        <Image Source="{Binding HinhAnhURL}" MaxWidth="75" MaxHeight="75" 
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{Binding TenMonAn}" FontWeight="Bold" 
                                                   FontSize="13" Foreground="#1976D2"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Gia, StringFormat={}{0:N0} đ}" 
                                                   Foreground="#4CAF50" FontSize="12" FontWeight="Bold" Margin="0,3,0,3"/>
                                        <TextBlock Grid.Row="2" Text="{Binding MoTa}" FontSize="11" 
                                                   TextWrapping="Wrap" Foreground="#666" MaxHeight="25"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>