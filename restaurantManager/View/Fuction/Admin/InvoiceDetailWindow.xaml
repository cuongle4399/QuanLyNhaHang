<Window x:Class="restaurantManager.View.Fuction.Admin.InvoiceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết hóa đơn" Height="600" Width="480"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="HÓA ĐƠN THANH TOÁN"
                 FontSize="24" FontWeight="Bold" TextAlignment="Center" 
                 Margin="0,0,0,20" Foreground="#1976D2"/>

            <Border CornerRadius="8" Padding="15" Margin="0,0,0,10" Background="White">
                <TextBlock x:Name="txtInfo" FontSize="13" LineHeight="22" Foreground="#424242"/>
            </Border>

            <Border CornerRadius="8" Padding="8" Margin="0,0,0,10" 
                    Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                <DataGrid x:Name="dgDetails"
                    AutoGenerateColumns="False" 
                    IsReadOnly="True" 
                    CanUserAddRows="False"
                    HeadersVisibility="Column" 
                    GridLinesVisibility="Horizontal"
                    CanUserResizeColumns="False"
                    RowHeight="35" 
                    ColumnHeaderHeight="40"
                    AlternatingRowBackground="#FAFAFA" 
                    RowBackground="White"
                    Foreground="#212121">
                    <DataGrid.Resources>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="#1976D2"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Món ăn"   Binding="{Binding TenMon}" Width="*"/>
                        <DataGridTextColumn Header="SL"       Binding="{Binding SoLuong}" Width="60"/>
                        <DataGridTextColumn Header="Đơn giá"  Binding="{Binding DonGia, StringFormat={}{0:N0} VNĐ}" Width="110"/>
                        <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0} VNĐ}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border CornerRadius="8" Padding="15" Margin="0,0,0,0" Background="#FFFFFF" 
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tổng cộng" FontSize="14" Foreground="#757575"/>
                        <TextBlock x:Name="txtSubtotal" Grid.Column="1" FontSize="14" 
                                   Foreground="#1976D2" FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Khuyến mãi" FontSize="14" Foreground="#757575"/>
                        <TextBlock x:Name="txtDiscountOrd" Grid.Column="1" FontSize="14" 
                                   Foreground="#E53935" FontWeight="Bold"/>
                    </Grid>

                    <Border BorderBrush="#BDBDBD" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="THANH TOÁN" FontSize="16" FontWeight="Bold" Foreground="#1976D2"/>
                            <TextBlock x:Name="txtTotal" Grid.Column="1" FontSize="18" FontWeight="Bold"
                                 Foreground="#1976D2"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>