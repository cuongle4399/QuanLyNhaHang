<UserControl x:Class="restaurantManager.View.Fuction.Staff.orderFood"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:restaurantManager.View.Fuction.Staff"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200"
             FontFamily="Segoe UI"
             Background="#F8F8F8">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1976D2"/>
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Fill="{TemplateBinding Background}" Stroke="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillOutlinedButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#1976D2"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🍽️ ĐẶT HÀNG" FontSize="20" FontWeight="Bold" Foreground="#1976D2"/>

                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,0" Background="#F5F5F5" BorderBrush="#BDBDBD" 
                             BorderThickness="1" VerticalContentAlignment="Center" Height="34" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" Content="🔍" Style="{StaticResource PrimaryButtonStyle}"
                            Width="34" Height="34" Padding="0" Margin="0"
                            Command="{Binding TimKiemCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" MaxHeight="140" Background="White" CornerRadius="5" Padding="10" 
                    BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🪑" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Disabled" 
                                  HorizontalScrollBarVisibility="Auto" PanningMode="HorizontalOnly">
                        <ItemsControl ItemsSource="{Binding DanhSachBanAn}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TableBorder" CornerRadius="5" BorderThickness="2" 
                                            BorderBrush="#E0E0E0" Margin="3,0" Cursor="Hand" Background="White" Width="50" Height="50">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="MouseDown">
                                                <i:InvokeCommandAction 
                                                    Command="{Binding DataContext.ChonBanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>

                                        <Grid>
                                            <Ellipse x:Name="TableEllipse" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding MaBan}" 
                                                       Foreground="White" FontWeight="Bold" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding TrangThai}" Value="Trống">
                                            <Setter TargetName="TableEllipse" Property="Fill" Value="#4CAF50"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TrangThai}" Value="Đã đặt">
                                            <Setter TargetName="TableEllipse" Property="Fill" Value="#FF9800"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="TableBorder" Property="BorderBrush" Value="#1976D2"/>
                                            <Setter TargetName="TableBorder" Property="BorderThickness" Value="3"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="📋 Tất cả" Command="{Binding ChonTatCaCommand}" 
                                Style="{StaticResource PillButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="🍽️ Thức ăn" Command="{Binding ChonThucAnCommand}" 
                                Style="{StaticResource PillOutlinedButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="🥤 Thức uống" Command="{Binding ChonThucUongCommand}" 
                                Style="{StaticResource PillOutlinedButtonStyle}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="icMonAn" ItemsSource="{Binding DanhSachHienThi}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Margin="0,0,10,10" Padding="8" 
                                            Width="140" Background="White"
                                            BorderBrush="#E0E0E0" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.1" Color="#000"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="110"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="34"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" CornerRadius="4" Margin="0,0,0,6" ClipToBounds="True">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding HinhAnhURL}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>

                                            <TextBlock Grid.Row="1" Text="{Binding TenMonAn}" FontSize="12" 
                                                       FontWeight="Bold" TextWrapping="Wrap" 
                                                       Foreground="#1976D2" MaxHeight="32" TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Row="2" Text="{Binding Gia, StringFormat={}{0:N0} đ}" 
                                                       FontSize="12" FontWeight="Bold" 
                                                       Foreground="#4CAF50" Margin="0,3,0,6"/>

                                            <Button Grid.Row="3" Content="➕ THÊM" 
                                                    Style="{StaticResource PrimaryButtonStyle}" 
                                                    Margin="0" FontSize="11"
                                                    Command="{Binding DataContext.ThemMonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Column="1" Background="White" CornerRadius="5" 
                        BorderBrush="#E0E0E0" BorderThickness="1" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="🛒 GIỎ HÀNG" FontSize="14" 
                                   FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,10"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <ItemsControl x:Name="icGioHang" ItemsSource="{Binding GioHang}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Margin="0,0,4,8" Padding="8" 
                                                Background="#FAFAFA" BorderBrush="#EEEEEE" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Text="{Binding TenMonAn}" FontSize="12" 
                                                           FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,6"/>

                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="−" Style="{StaticResource CircleButtonStyle}"
                                                                Margin="0,0,4,0" FontSize="12" Width="24" Height="24"
                                                                Command="{Binding DataContext.GiamSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>

                                                        <TextBlock Text="{Binding SoLuong}" Width="20" 
                                                                   TextAlignment="Center" VerticalAlignment="Center" 
                                                                   FontSize="12" FontWeight="Bold"/>

                                                        <Button Content="+" Style="{StaticResource CircleButtonStyle}"
                                                                Margin="4,0,0,0" FontSize="12" Width="24" Height="24"
                                                                Command="{Binding DataContext.TangSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" 
                                                               Text="{Binding Gia, StringFormat={}{0:N0} đ}" 
                                                               Foreground="#1976D2" FontSize="12" FontWeight="Bold"
                                                               VerticalAlignment="Center" TextAlignment="Right"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2">
                            <Border CornerRadius="6" Padding="10" Background="#F0F7FF" Margin="0,0,0,10" 
                                    BorderBrush="#BBDEFB" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="TỔNG" FontSize="12" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TongTienGioHang, StringFormat={}{0:N0} đ}" 
                                               Foreground="#1976D2" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="✅ ĐẶT HÀNG" Style="{StaticResource PrimaryButtonStyle}"
                                        Height="38" Margin="0,0,6,0" FontSize="12"
                                        Command="{Binding DataContext.XacNhanDatBanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Button Grid.Column="1" Content="❌ HỦY" Style="{StaticResource PillOutlinedButtonStyle}"
                                        Height="38" Width="70"
                                        Command="{Binding HuyDonHangCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>