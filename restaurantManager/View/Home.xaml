<Window x:Class="restaurantManager.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Nhà Hàng" Height="550" Width="550"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/Image/logo/logo.ico"
        ResizeMode="NoResize"
        Background="#FAFAFA"
        FontFamily="Segoe UI">
    <Grid Background="#FAFAFA" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Width="420">

            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,30">
                <TextBlock Text="🍽️ NHÀ HÀNG" FontSize="28" FontWeight="Bold" 
                           Foreground="#1976D2" HorizontalAlignment="Center"/>
                <TextBlock Text="Hệ thống quản lý" FontSize="12" 
                           Foreground="#757575" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Card chứa TabControl -->
            <materialDesign:Card Background="White" Padding="0" Margin="0" Height="500">
                <Border CornerRadius="8" Background="White" ClipToBounds="True">
                    <TabControl Width="420" Height="500" 
                            materialDesign:ColorZoneAssist.Foreground="#1976D2"
                            materialDesign:ColorZoneAssist.Mode="Custom"
                            Foreground="#000000"
                            Background="White">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#999999"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="20,14"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Grid>
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                                                </Border>
                                                <Border Height="4" VerticalAlignment="Bottom" Background="Transparent"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="#1976D2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- Tab Đăng Nhập -->
                        <TabItem Header="📝 Đăng Nhập">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="30,30,30,30">

                                    <!-- Tài khoản -->
                                    <TextBlock Text="Tài khoản" FontSize="12" FontWeight="Bold" 
                                       Foreground="#424242" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtLoginUsername" Height="40" Margin="0,0,0,20" 
                                     materialDesign:HintAssist.Hint="Nhập tài khoản của bạn" 
                                     FontSize="14"
                                     Background="#F5F5F5" 
                                     Foreground="#212121" 
                                     BorderBrush="#E0E0E0"
                                     BorderThickness="0,0,0,2"
                                     Padding="12,8"/>

                                    <!-- Mật khẩu -->
                                    <TextBlock Text="Mật khẩu" FontSize="12" FontWeight="Bold" 
                                       Foreground="#424242" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,20">
                                        <PasswordBox x:Name="txtLoginPassword" Height="40" 
                                             materialDesign:HintAssist.Hint="Nhập mật khẩu" 
                                             FontSize="14"
                                             Background="#F5F5F5" 
                                             Foreground="#212121" 
                                             BorderBrush="#E0E0E0"
                                             BorderThickness="0,0,0,2"
                                             Padding="12,8"/>
                                        <TextBox x:Name="txtShowPassword" 
                                         materialDesign:HintAssist.Hint="Nhập mật khẩu" 
                                         Height="40" 
                                         Visibility="Collapsed" 
                                         FontSize="14"
                                         Background="#F5F5F5" 
                                         Foreground="#212121" 
                                         BorderBrush="#E0E0E0"
                                         BorderThickness="0,0,0,2"
                                         Padding="12,8"/>
                                    </Grid>

                                    <!-- Hiện mật khẩu -->
                                    <CheckBox x:Name="chkShowLoginPassword" Content="Hiện mật khẩu" 
                                      Margin="0,0,0,25" Foreground="#424242"/>

                                    <!-- Nút đăng nhập -->
                                    <Button Content="✅ ĐĂNG NHẬP" Height="44" 
                                    Background="#1976D2" Foreground="White" 
                                    FontWeight="Bold" FontSize="14"
                                    Cursor="Hand"
                                    Click="bthLogin_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab Đăng Ký -->
                        <TabItem Header="📋 Đăng Ký">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="30,30,30,30">

                                    <!-- Tài khoản -->
                                    <TextBlock Text="Tài khoản" FontSize="12" FontWeight="Bold" 
                                       Foreground="#424242" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtRegisterUsername" Height="40" Margin="0,0,0,18" 
                                     materialDesign:HintAssist.Hint="Nhập tài khoản mới" 
                                     FontSize="14"
                                     Background="#F5F5F5" 
                                     Foreground="#212121" 
                                     BorderBrush="#E0E0E0"
                                     BorderThickness="0,0,0,2"
                                     Padding="12,8"/>

                                    <!-- Mật khẩu -->
                                    <TextBlock Text="Mật khẩu" FontSize="12" FontWeight="Bold" 
                                       Foreground="#424242" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,18">
                                        <PasswordBox x:Name="txtRegisterPassword" Height="40" 
                                             materialDesign:HintAssist.Hint="Nhập mật khẩu" 
                                             FontSize="14"
                                             Background="#F5F5F5" 
                                             Foreground="#212121" 
                                             BorderBrush="#E0E0E0"
                                             BorderThickness="0,0,0,2"
                                             Padding="12,8"/>
                                        <TextBox x:Name="txtShowRegisterPassword" 
                                         materialDesign:HintAssist.Hint="Nhập mật khẩu" 
                                         Height="40" 
                                         Visibility="Collapsed" 
                                         FontSize="14"
                                         Background="#F5F5F5" 
                                         Foreground="#212121" 
                                         BorderBrush="#E0E0E0"
                                         BorderThickness="0,0,0,2"
                                         Padding="12,8"/>
                                    </Grid>

                                    <!-- Xác nhận mật khẩu -->
                                    <TextBlock Text="Xác nhận mật khẩu" FontSize="12" FontWeight="Bold" 
                                       Foreground="#424242" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,18">
                                        <PasswordBox x:Name="txtRegisterConfirm" Height="40" 
                                             materialDesign:HintAssist.Hint="Xác nhận mật khẩu" 
                                             FontSize="14"
                                             Background="#F5F5F5" 
                                             Foreground="#212121" 
                                             BorderBrush="#E0E0E0"
                                             BorderThickness="0,0,0,2"
                                             Padding="12,8"/>
                                        <TextBox x:Name="txtShowRegisterConfirm" 
                                         materialDesign:HintAssist.Hint="Xác nhận mật khẩu" 
                                         Height="40" 
                                         Visibility="Collapsed" 
                                         FontSize="14"
                                         Background="#F5F5F5" 
                                         Foreground="#212121" 
                                         BorderBrush="#E0E0E0"
                                         BorderThickness="0,0,0,2"
                                         Padding="12,8"/>
                                    </Grid>

                                    <!-- Hiện mật khẩu -->
                                    <CheckBox x:Name="chkShowRegisterPassword" Content="Hiện mật khẩu" 
                                      Margin="0,0,0,25" Foreground="#424242"/>

                                    <!-- Nút đăng ký -->
                                    <Button Content="✅ ĐĂNG KÝ" Height="44" 
                                    Background="#4CAF50" Foreground="White" 
                                    FontWeight="Bold" FontSize="14"
                                    Cursor="Hand"
                                    Click="btnRegister_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </materialDesign:Card>
        </StackPanel>
    </Grid>
</Window>