<Window x:Class="restaurantManager.View.AddPromotionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Height="650" Width="600"
        Background="#2E2E2E" Foreground="White"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="QUẢN LÝ KHUYẾN MÃI" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="0" Margin="0,0,0,25"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,15">
                <TextBlock Text="Tên chương trình:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding TenChuongTrinh, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         materialDesign:HintAssist.Hint="Nhập tên chương trình"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,15">
                <TextBlock Text="Mã giảm giá:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding MaCode, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         materialDesign:HintAssist.Hint="Nhập mã giảm giá (VD: FOOD10)"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Loại giảm giá:" Margin="0,0,0,5"/>
                <ComboBox SelectedValue="{Binding LoaiGiamGia, UpdateSourceTrigger=PropertyChanged}" 
                          SelectedValuePath="Tag"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}">
                    <ComboBoxItem Content="Giảm %" Tag="PhanTram"/>
                    <ComboBoxItem Content="Giảm tiền" Tag="TienCoDinh"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Giá trị giảm:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding GiaTriGiam, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         materialDesign:HintAssist.Hint="Nhập giá trị (VD: 10 hoặc 50000)"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,15">
                <TextBlock Text="Ngày bắt đầu:" Margin="0,0,0,5"/>
                <DatePicker SelectedDate="{Binding NgayBatDau}" 
                            Style="{StaticResource MaterialDesignDatePicker}"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,15">
                <TextBlock Text="Ngày kết thúc:" Margin="0,0,0,5"/>
                <DatePicker SelectedDate="{Binding NgayKetThuc}" 
                            Style="{StaticResource MaterialDesignDatePicker}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,0">
                <TextBlock Text="Số lượt tối đa (để trống nếu không giới hạn):" Margin="0,0,0,5"/>
                <TextBox Text="{Binding SoLuotSuDungToiDa, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         materialDesign:HintAssist.Hint="Số lượt (VD: 50)"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Text="Áp dụng cho món ăn:" Margin="0,0,0,5" FontWeight="Bold"/>
        <ScrollViewer Grid.Row="4" Margin="0,0,0,20">
            <ItemsControl ItemsSource="{Binding MonAnList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Width="180" Margin="0,5,15,5">
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding TenMonAn}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="5" Margin="0,20,0,0">
            <Button Content="Hủy" Style="{StaticResource MaterialDesignFlatButton}" 
                    Click="Cancel_Click" Margin="0,0,10,0"/>
            <Button Content="Lưu" Style="{StaticResource MaterialDesignRaisedButton}" 
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>